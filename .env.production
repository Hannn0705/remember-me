# ============================================
# Remember Me - Production Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://remember_me:remember_me_pass@postgres:5432/remember_me?schema=public"

# JWT
JWT_SECRET="change-this-to-a-very-long-random-string-in-production"
JWT_REFRESH_SECRET="change-this-to-another-very-long-random-string"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Redis
REDIS_URL="redis://redis:6379"

# SMTP / Email (Configure with your SMTP provider)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@remember-me.app"
EMAIL_FROM_NAME="Remember Me"

# Frontend URL
NEXT_PUBLIC_API_URL="https://your-domain.com/api"
FRONTEND_URL="https://your-domain.com"

# App
NODE_ENV="production"
PORT=3001

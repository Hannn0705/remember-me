# ============================================
# Remember Me - Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://remember_me:remember_me_pass@localhost:5432/remember_me?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# SMTP / Email (Resend recommended)
RESEND_API_KEY="re_xxxxxxxxxxxx"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@remember-me.app"
EMAIL_FROM_NAME="Remember Me"

# Frontend URL (for CORS and email links)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
FRONTEND_URL="http://localhost:3000"

# App
NODE_ENV="development"
PORT=3001
